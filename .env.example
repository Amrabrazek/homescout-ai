# Copy to .env. Every value has a working default for local development,
# so this file is only needed to override something.

# Postgres
DB_USERNAME=homescout
DB_PASSWORD=homescout
DB_NAME=homescout

# Typesense
TYPESENSE_API_KEY=xyz

# Object storage (MinIO locally, any S3-compatible service elsewhere)
S3_ACCESS_KEY=homescout
S3_SECRET_KEY=homescout-secret
S3_BUCKET=images
S3_PUBLIC_URL=http://localhost:9000/images

# Optional: enables OpenAI embeddings for similar units
OPENAI_API_KEY=

# Concierge agent (frontend /api/chat) and the search parser's LLM step (backend).
# Pick the provider and model by env only.
# LLM_PROVIDER: anthropic (default, claude-haiku-5-5) or openai (gpt-5-mini, uses OPENAI_API_KEY above)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
# Feature flag: let an LLM parse what the search regex misses (needs the key above)
SEARCH_LLM_ENABLED=false
# Max LLM calls per day for parsing search queries; after that, regex only
SEARCH_LLM_DAILY_LIMIT=500
# Days an LLM search parse stays cached in Postgres (0 = memory cache only)
SEARCH_PARSE_CACHE_DAYS=30

# Optional: Langfuse traces for each concierge turn
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
