# For running the backend outside Docker (npm run start:dev) against the
# services started by `docker compose up postgres typesense minio minio-init`.
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=homescout
DB_PASSWORD=homescout
DB_NAME=homescout

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/images
S3_BUCKET=images
S3_ACCESS_KEY=homescout
S3_SECRET_KEY=homescout-secret

# Embeddings: local-e5-small (free, runs in Node) or openai-text-embedding-3-small
# (needs OPENAI_API_KEY). After changing it, run `npm run reindex`.
EMBEDDING_MODEL=local-e5-small
OPENAI_API_KEY=

# Feature flag: show what a payment plan is worth in today's money
PLAN_VALUE_ENABLED=true
# Yearly rate used to value payment plans in today's money (0.2 = 20%)
MARKET_DISCOUNT_RATE=0.2

# The API runs the unit sync worker (embeddings + Typesense) unless this is false
WORKER=true
