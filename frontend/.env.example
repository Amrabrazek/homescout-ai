# Browser-facing URLs
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:3001/graphql
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_USE_TYPESENSE=true

# Server-side GraphQL URL (inside Docker this is http://backend:3001/graphql)
GRAPHQL_ENDPOINT=http://localhost:3001/graphql

# Server-side REST base for the concierge tools (inside Docker this is http://backend:3001)
API_URL=http://localhost:3001

# Concierge agent (/api/chat). LLM_PROVIDER: anthropic (default, claude-haiku-5-5)
# or openai (gpt-5-mini). LLM_MODEL overrides the model id.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Langfuse traces for each concierge turn (on only when both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
